# Local development defaults to SQLite when DATABASE_URL is omitted.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Omit DATABASE_URL for the project-local SQLite database.

# PostgreSQL example:
# DATABASE_URL=postgresql://schoolos:replace-me@127.0.0.1:5432/schoolos

# Production:
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=school.example.org
# DJANGO_CSRF_TRUSTED_ORIGINS=https://school.example.org
# DJANGO_SECURE_SSL_REDIRECT=true
